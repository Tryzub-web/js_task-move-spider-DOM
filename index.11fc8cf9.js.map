"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
document.addEventListener("click", function(e) {
    if (e.target.closest(".wall")) {
        var spiderWidth = spider.clientWidth;
        var spiderHeight = spider.clientHeight;
        var wallRect = wall.getBoundingClientRect();
        var wallLeft = wallRect.left + wall.clientLeft;
        var wallTop = wallRect.top + wall.clientTop;
        var spiderLeft = e.clientX - wallLeft - spiderWidth / 2;
        var maxLeft = wall.clientWidth - spiderWidth;
        var spiderTop = e.clientY - wallTop - spiderHeight / 2;
        var maxTop = wall.clientHeight - spiderHeight;
        spider.style.left = "".concat(Math.min(Math.max(spiderLeft, 0), maxLeft), "px");
        spider.style.top = "".concat(Math.min(Math.max(spiderTop, 0), maxTop), "px");
    }
});

